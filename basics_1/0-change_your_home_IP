#!/usr/bin/env bash
# Sets localhost to resolve to 127.0.0.2 and facebook.com to resolve to 8.8.8.8

{
	grep -v -E '(^|[[:space:]])localhost$' /etc/hosts | grep -v -E '(^|[[:space:]])facebook\.com$'
	echo "127.0.0.2	localhost"
	echo "8.8.8.8	facebook.com"
} > /tmp/hosts.new

cat /tmp/hosts.new > /etc/hosts
